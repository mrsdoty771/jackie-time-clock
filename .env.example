# Copy to .env and fill in your values. Do not commit .env.
# Production (DigitalOcean): set the same keys in App-Level Environment Variables — see DEPLOY.md.

# Database
DATABASE_URL=mongodb://localhost:27017/your-db-name

# Session (optional locally; required in production)
SESSION_SECRET=your-secret-string

# Node (DigitalOcean App Platform usually sets NODE_ENV=production)
# NODE_ENV=production

# Public app URL for login invite links in SMS (required in production)
# Local dev: optional — defaults to http://127.0.0.1:PORT when NODE_ENV is not production
# Production example:
# BASE_URL=https://hammerhead-app-otcfa.ondigitalocean.app
# BASE_URL=http://127.0.0.1:3000

# Email report (required to use "Email Report" PDF feature)
# Without these, the app returns 503 when trying to send report email.
#
# Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
#
# Office 365 (business email, e.g. myvaluecars.com):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-name@myvaluecars.com
SMTP_PASS=your-password
SMTP_FROM=your-name@myvaluecars.com

# Twilio SMS — optional if configured in manager → Company Settings → SMS (Twilio)
# Per-field fallback: Company Settings first, then these env vars
# TWILIO_PHONE_NUMBER = Twilio "From" number (E.164, e.g. +15551234567)
# TWILIO_NOTIFY_PHONE = your phone for punch alerts only (E.164)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_NOTIFY_PHONE=
