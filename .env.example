# Copy to .env and fill in your values. Do not commit .env.

# Database
DATABASE_URL=mongodb://localhost:27017/your-db-name

# Session (optional; default used if not set)
SESSION_SECRET=your-secret-string

# Public app URL for login invite links in SMS (required in production)
# Local dev: optional — defaults to http://127.0.0.1:PORT when NODE_ENV is not production
# BASE_URL=http://127.0.0.1:3000

# Email report (required to use "Email Report" PDF feature)
# Without these, the app returns 503 when trying to send report email.
#
# Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
#
# Office 365 (business email, e.g. myvaluecars.com):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-name@myvaluecars.com
SMTP_PASS=your-password
SMTP_FROM=your-name@myvaluecars.com

# Twilio SMS (optional; get a text when someone clocks in/out or lunch in/out)
# Get Account SID and Auth Token from https://console.twilio.com
# TWILIO_PHONE_NUMBER = your Twilio "From" number (e.g. +15551234567)
# TWILIO_NOTIFY_PHONE = your phone number to receive texts (e.g. +15559876543)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_NOTIFY_PHONE=
